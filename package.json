{
  "name": "maze-test",
  "version": "0.4.0",
  "description": "Generate deterministic bilingual maze reasoning questions and answer keys.",
  "keywords": [
    "maze",
    "generator",
    "reasoning",
    "cli"
  ],
  "homepage": "https://github.com/ziioai/maze-test#readme",
  "bugs": {
    "url": "https://github.com/ziioai/maze-test/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziioai/maze-test.git"
  },
  "license": "MIT",
  "author": "ziioai",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "maze-test": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README-CN.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test",
    "check": "pnpm run typecheck && pnpm run build && node --test",
    "prepublishOnly": "pnpm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0",
  "volta": {
    "node": "24.19.0",
    "pnpm": "11.23.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
